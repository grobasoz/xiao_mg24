{
    "version": "0.2.0",
    "configurations": [
      {
        "cwd": "${workspaceRoot}",
        "request": "attach",
        "type": "cortex-debug",
        "executable": "${workspaceRoot}/firmware/SOC/${fileBasenameNoExtension}/${fileBasenameNoExtension}.axf",
        "toolchainPrefix": "arm-none-eabi",
        "overrideRestartCommands": [
          "monitor reset halt",
          "monitor gdb_sync",
          "c"
        ],
        "postAttachCommands": [
          "monitor reset halt",
          "monitor gdb_sync",
          "c"
        ],
        "name": "Seeed Studio XIAO MG24 (Sense)",
        "serverpath": "$HOME/Library/Arduino15/packages/SiliconLabs/tools/openocd/0.12.0-arduino1-static/bin/openocd",
        "servertype": "openocd",
        "armToolchainPath": "$HOME/Library/Arduino15/packages/SiliconLabs/tools/gcc-arm-none-eabi/12.2.rel1/bin/",
        "configFiles": [
          "interface/cmsis-dap.cfg",
          "target/efm32s2_g23.cfg"
        ]
      },
      {
        "cwd": "${workspaceRoot}",
        "request": "attach",
        "type": "cortex-debug",
        "executable": "${workspaceRoot}/firmware/SOC/${fileBasenameNoExtension}/${fileBasenameNoExtension}.axf",
        "toolchainPrefix": "arm-none-eabi",
        "overrideRestartCommands": [
          "monitor reset halt",
          "monitor gdb_sync",
          "tbreak main",
          "c"
        ],
        "postAttachCommands": [
          "monitor reset halt",
          "monitor gdb_sync",
          "tbreak main",
          "c"
        ],
        "name": "Seeed Studio XIAO MG24 (Sense) (openocd)",
        "serverpath": "$HOME/Library/Arduino15/packages/SiliconLabs/tools/openocd/0.12.0-arduino1-static/bin/openocd",
        "servertype": "openocd",
        "armToolchainPath": "$HOME/Library/Arduino15/packages/SiliconLabs/tools/gcc-arm-none-eabi/12.2.rel1/bin/",
        "configFiles": [
          "interface/cmsis-dap.cfg",
          "target/efm32s2_g23.cfg"
        ]
      }
    ]
  }